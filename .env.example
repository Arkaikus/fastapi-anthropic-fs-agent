# ── Anthropic / Ollama ────────────────────────────────────────────────────────
# For Anthropic cloud (default):
ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_BASE_URL=          # leave blank for cloud

# For Ollama (local):
# ANTHROPIC_API_KEY=ollama      # any non-empty string
# ANTHROPIC_BASE_URL=http://ollama:11434/v1
# MODEL=llama3.1                # any model pulled in Ollama

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MODEL=claude-opus-4-5

# Inside Docker the workspace is mounted at /workspace
DEFAULT_BASE_DIR=/workspace

# Optional agent loop tuning
# AGENT_MAX_TOKENS=2048
# AGENT_MAX_ITERATIONS=8
